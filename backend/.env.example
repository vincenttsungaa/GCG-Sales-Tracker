MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=app
DB_NAME=tracker
CORS_ORIGINS=http://localhost:3000
APP_TZ=Australia/Sydney

# Email for "Export to Excel → Send by email" (optional). Example for Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<a Gmail app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Accounts (backend/lib/auth.py)
# The account that gets the listings made before accounts existed, once its email is confirmed
CLAIM_EMAIL=
# Other emails that may update the card / product databases (comma-separated); CLAIM_EMAIL always can
ADMIN_EMAILS=
# Accounts that get every plan perk (no owner tools), e.g. the developer's own collection (comma-separated)
PERKS_EMAILS=
# Where links in emails (confirm email, reset password) point; default: the first CORS_ORIGINS entry
APP_URL=
# true once the site is served over https
COOKIE_SECURE=false
# true on the live server behind Cloudflare: log-in and sign-up limits then count each visitor's own
# address (CF-Connecting-IP) instead of the tunnel's. Leave false on your PC.
TRUST_CLOUDFLARE=false

# Memberships are Buy Me a Coffee memberships (buymeacoffee.com/cardstakk). In BMC: Settings → Webhooks →
# add https://<your site>/api/bmc/webhook with the membership events, then paste its Signing Secret here.
# Level names must contain "Collector" or "Dealer" (that's how a member is matched to a plan).
BMC_WEBHOOK_SECRET=
